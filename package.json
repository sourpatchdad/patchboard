{
  "name": "patchboard",
  "version": "1.8.1",
  "private": true,
  "description": "A control center and start page for a home server.",
  "license": "AGPL-3.0-only",
  "author": "Nathan Nicholas <github@nbnstack.com>",
  "homepage": "https://github.com/sourpatchdad/patchboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourpatchdad/patchboard.git"
  },
  "bugs": "https://github.com/sourpatchdad/patchboard/issues",
  "keywords": ["homelab", "self-hosted", "dashboard", "docker", "start-page"],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "dev:demo": "cross-env DEMO=1 DATA_DIR=./data-demo npm run dev",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "icons": "node scripts/make-icons.mjs",
    "docs": "node --disable-warning=ExperimentalWarning scripts/gen-docs.ts",
    "release:check": "node scripts/release-check.ts",
    "docs:check": "node --disable-warning=ExperimentalWarning scripts/gen-docs.ts --check",
    "i18n:check": "node scripts/i18n-keys.mjs --check",
    "screenshots": "node scripts/screenshots.mjs",
    "test:zoom": "npm run build && node scripts/check-zoom.mjs",
    "test:a11y": "npm run build && node scripts/check-accessibility.mjs",
    "test:ui": "npm run build && node scripts/check-home.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"require('fs').rmSync('data-test',{recursive:true,force:true})\"",
    "test": "cross-env DATA_DIR=./data-test DOCS_PATH=server/test/fixtures LOGS_PATH=server/test/fixtures CHECK_DOMAINS=example.org node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"server/test/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "ws": "^8.22.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "dompurify": "^3.2.3",
    "marked": "^18.1.3",
    "playwright-core": "^1.65.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
