{
  "name": "patchboard",
  "version": "1.10.0",
  "private": true,
  "description": "A control center and start page for a home server.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "dev:demo": "cross-env DEMO=1 DATA_DIR=./data-demo npm run dev",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "import-homepage": "node scripts/import-homepage.ts",
    "icons": "node scripts/make-icons.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"require('fs').rmSync('data-test',{recursive:true,force:true})\"",
    "test": "cross-env DATA_DIR=./data-test DOCS_PATH=server/test/fixtures LOGS_PATH=server/test/fixtures CHECK_DOMAINS=example.org node --disable-warning=ExperimentalWarning --test \"server/test/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "dompurify": "^3.2.3",
    "hono": "^4.6.14",
    "marked": "^18.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "ws": "^8.22.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
