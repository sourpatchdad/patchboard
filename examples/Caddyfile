# HTTPS on a private network, so phones can install Patchboard as an app.
# Point dash.example.com at your server's private or Tailscale address.
# Needs a Caddy build with your DNS provider, e.g. ghcr.io/caddybuilds/caddy-cloudflare.
# Patchboard answers only names it knows: set ALLOWED_HOSTS=dash.example.com,
# or add the name in Settings, Connections, Sign-in and keys.

dash.example.com {
	bind 100.64.0.10
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3200 {
		# Live updates must not be buffered.
		flush_interval -1
	}
}
