# Copy to .env next to docker-compose.yml. Never commit the copy.
#
# The first sections are server settings: fill in the address and time zone,
# and sign-in if Patchboard is reachable by anyone but you.
#
# Everything from Weather down is optional. The easier way is Settings,
# Connections in Patchboard, which tests the connection and encrypts the key.
# Set an integration here only if you keep config in git; a value here wins
# and shows in Settings as locked. docs/INTEGRATIONS.md says where each key
# comes from.

# ---- Server -----------------------------------------------------------------

# The address you browse from: a Tailscale IP, a LAN IP, or 127.0.0.1 behind
# a reverse proxy. Never a public address without sign-in.
BIND_ADDRESS=127.0.0.1
TZ=America/New_York
# Names you reach Patchboard by, e.g. dash.example.com. Blocks DNS rebinding.
ALLOWED_HOSTS=
DEMO=0

# ---- Sign-in and safety (SECURITY.md) ---------------------------------------

# none, forward (behind Authelia, Authentik, Cloudflare Access), oidc or password
AUTH=none
TRUSTED_USER_HEADER=Remote-User
PATCHBOARD_PASSWORD=
# For AUTH=oidc: the issuer, the client you created there, who may sign in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ALLOWED=
OIDC_NAME=
HOOK_TOKEN=
READ_ONLY=0
DOCKER_SOCKET=/var/run/docker.sock
# tcp://socket-proxy:2375 to use a socket proxy instead of the socket
DOCKER_HOST=

# ---- Thresholds -------------------------------------------------------------

# Your own domains whose app links Patchboard checks, e.g. example.com
CHECK_DOMAINS=
POOL_WARN_PCT=85
DISK_WARN_C=50
UPCOMING_DAYS=14

# ============================================================================
# Integrations: optional here. Settings, Connections is the easier way.
# ============================================================================

# ---- Weather (no key) -------------------------------------------------------

WEATHER_LAT=
WEATHER_LON=
WEATHER_LABEL=

# ---- Media ------------------------------------------------------------------

SONARR_URL=http://192.168.1.10:8989
SONARR_KEY=

RADARR_URL=http://192.168.1.10:7878
RADARR_KEY=

TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_KEY=

JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_KEY=
# Whose Next up to show. Blank uses the first admin.
JELLYFIN_USER=

EMBY_URL=http://192.168.1.10:8096
EMBY_KEY=
EMBY_USER=

QBIT_URL=http://192.168.1.10:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# Transmission. The login only if rpc-authentication-required is on.
TRANSMISSION_URL=http://192.168.1.10:9091
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

DELUGE_URL=http://192.168.1.10:8112
DELUGE_PASSWORD=

SABNZBD_URL=http://192.168.1.10:8080
SABNZBD_KEY=

NZBGET_URL=http://192.168.1.10:6789
NZBGET_USERNAME=
NZBGET_PASSWORD=

# Create an app at app.trakt.tv/settings/apps, set the Client ID here, then
# connect from Settings, Connections. Trakt no longer issues client secrets.
TRAKT_CLIENT_ID=
# Only if your Trakt app's redirect URI isn't http://localhost
TRAKT_REDIRECT_URI=

# ---- Reading and mail -------------------------------------------------------

MINIFLUX_URL=http://192.168.1.10:8084
MINIFLUX_TOKEN=

FASTMAIL_TOKEN=
FASTMAIL_WEB_URL=https://app.fastmail.com/mail/Inbox/

# ---- Home and logs ----------------------------------------------------------

FRIGATE_URL=http://192.168.1.10:5000
DOZZLE_URL=

# Push notifications, opt-in: ntfy (a topic address) or Gotify (an app
# token), or both. NOTIFY_LEVEL=critical sends outages only. PATCHBOARD_URL
# makes a tap open Patchboard.
NTFY_URL=
NTFY_TOKEN=
GOTIFY_URL=
GOTIFY_TOKEN=
NOTIFY_LEVEL=warn
PATCHBOARD_URL=

# Speedtest Tracker 1.0+: an API token with Read results.
SPEEDTEST_URL=http://192.168.1.10:8765
SPEEDTEST_TOKEN=

# Immich: an admin's API key (Account Settings, API Keys).
IMMICH_URL=http://192.168.1.10:2283
IMMICH_KEY=

# Overseerr or Jellyseerr: Settings, General, API Key.
OVERSEERR_URL=http://192.168.1.10:5055
OVERSEERR_KEY=

# Ad blocking. Pi-hole 6+: an app password from Settings, Web interface / API
# (blank when the web interface has no password). AdGuard Home: your sign-in.
PIHOLE_URL=http://192.168.1.10:8053
PIHOLE_PASSWORD=
ADGUARD_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Uptime Kuma: a status page's monitors. No key; the slug is the end of
# the page's address (/status/home is home).
UPTIME_KUMA_URL=http://192.168.1.10:3001
UPTIME_KUMA_SLUG=home

# ---- TrueNAS ----------------------------------------------------------------

# A key for a user whose only role is Read-Only Administrator. wss:// only:
# TrueNAS revokes a key sent over plain ws://.
TRUENAS_URL=wss://192.168.1.10/api/current
TRUENAS_API_KEY=
# 1 if your TrueNAS has a real certificate (it ships a self-signed one)
TRUENAS_VERIFY_TLS=0

# ---- Scrutiny ---------------------------------------------------------------

# Scrutiny's web address. No key: keep it on a private address.
SCRUTINY_URL=http://192.168.1.10:8080

# ---- Proxmox VE -------------------------------------------------------------

# An API token with the PVEAuditor role (Datacenter, Permissions, API Tokens).
PROXMOX_URL=https://192.168.1.20:8006
PROXMOX_TOKEN_ID=patchboard@pve!dash
PROXMOX_SECRET=
# 1 if Proxmox has a real certificate (it ships a self-signed one)
PROXMOX_VERIFY_TLS=0

# Home Assistant: a long-lived access token from your profile, Security.
HA_URL=http://192.168.1.10:8123
HA_TOKEN=

# Tessie, for a Tesla. TESSIE_VIN only if the account has more than one car.
TESSIE_TOKEN=
TESSIE_VIN=

# Wake-on-LAN: Name=MAC pairs. Needs host networking (examples/wake-on-lan).
WOL_DEVICES=
WOL_BROADCAST=255.255.255.255
