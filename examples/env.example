# Optional. Patchboard needs no .env: Settings covers integrations, alerts,
# sign-in and host names. This lists every variable for config as code. To
# use it, copy to .env next to docker-compose.yml, keep the lines you set, and
# add `env_file: .env` to the service. Never commit the copy.
#
# A value here wins and shows in Settings as locked. docs/INTEGRATIONS.md
# says where each key comes from.

# ---- Server -----------------------------------------------------------------

TZ=America/New_York
# Other names you reach Patchboard by, e.g. dash.example.com. Blocks DNS rebinding.
ALLOWED_HOSTS=
DEMO=0

# ---- Sign-in and safety (SECURITY.md) ---------------------------------------

# none, forward (behind Authelia, Authentik, Cloudflare Access), oidc or password
AUTH=none
TRUSTED_USER_HEADER=Remote-User
PATCHBOARD_PASSWORD=
# For AUTH=oidc: the issuer, the client you created there, who may sign in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ALLOWED=
OIDC_NAME=
HOOK_TOKEN=
READ_ONLY=0
DOCKER_SOCKET=/var/run/docker.sock
# tcp://socket-proxy:2375 to use a socket proxy instead of the socket
DOCKER_HOST=

# ---- Alerts -----------------------------------------------------------------

# Set these in Settings, Alerts instead; a value here wins and shows locked.
# Your own domains whose app links Patchboard checks, e.g. example.com
CHECK_DOMAINS=
POOL_WARN_PCT=85
POOL_CRIT_PCT=95
DISK_WARN_C=50
DISK_CRIT_C=58
UPCOMING_DAYS=14

# ---- Folders ----------------------------------------------------------------

# Mounts at /pool, /docs and /logs need nothing here. Set these only to mount
# somewhere else. COMPOSE_ROOT limits updates from the UI to one folder.
POOL_PATH=
DOCS_PATH=
LOGS_PATH=
COMPOSE_ROOT=

# ============================================================================
# Integrations: optional here. Settings, Connections is the easier way.
# ============================================================================

# ---- Pushover, email ------------------------------------------------------------

# Pushover: your User Key, and an application's token.
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=
# Email: host:port (465 TLS, or 587 STARTTLS), an app password where needed.
SMTP_HOST=smtp.example.com:465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=patchboard@example.com
SMTP_TO=you@example.com
# 0 only for a relay on your network with a self-signed certificate
SMTP_VERIFY_TLS=1

# ---- Weather (no key) -------------------------------------------------------

WEATHER_LAT=
WEATHER_LON=
WEATHER_LABEL=

# ---- Media ------------------------------------------------------------------

SONARR_URL=http://192.168.1.10:8989
SONARR_KEY=

RADARR_URL=http://192.168.1.10:7878
RADARR_KEY=

TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_KEY=

JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_KEY=
# Whose Next up to show. Blank uses the first admin.
JELLYFIN_USER=

EMBY_URL=http://192.168.1.10:8096
EMBY_KEY=
EMBY_USER=

QBIT_URL=http://192.168.1.10:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# Transmission. The login only if rpc-authentication-required is on.
TRANSMISSION_URL=http://192.168.1.10:9091
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

DELUGE_URL=http://192.168.1.10:8112
DELUGE_PASSWORD=

SABNZBD_URL=http://192.168.1.10:8080
SABNZBD_KEY=

NZBGET_URL=http://192.168.1.10:6789
NZBGET_USERNAME=
NZBGET_PASSWORD=

# Create an app at app.trakt.tv/settings/apps, set the Client ID here, then
# connect from Settings, Connections. Trakt no longer issues client secrets.
TRAKT_CLIENT_ID=
# Only if your Trakt app's redirect URI isn't http://localhost
TRAKT_REDIRECT_URI=

# ---- Reading and mail -------------------------------------------------------

MINIFLUX_URL=http://192.168.1.10:8084
MINIFLUX_TOKEN=

FASTMAIL_TOKEN=
FASTMAIL_WEB_URL=https://app.fastmail.com/mail/Inbox/

# ---- Home and logs ----------------------------------------------------------

FRIGATE_URL=http://192.168.1.10:5000
DOZZLE_URL=

# Push notifications, opt-in: ntfy (a topic address) or Gotify (an app
# token), or both. NOTIFY_LEVEL=critical sends outages only. PATCHBOARD_URL
# makes a tap open Patchboard.
NTFY_URL=
NTFY_TOKEN=
GOTIFY_URL=
GOTIFY_TOKEN=
NOTIFY_LEVEL=warn
PATCHBOARD_URL=

# Speedtest Tracker 1.0+: an API token with Read results.
SPEEDTEST_URL=http://192.168.1.10:8765
SPEEDTEST_TOKEN=

# Immich: an admin's API key (Account Settings, API Keys).
IMMICH_URL=http://192.168.1.10:2283
IMMICH_KEY=

# Overseerr or Jellyseerr: Settings, General, API Key.
OVERSEERR_URL=http://192.168.1.10:5055
OVERSEERR_KEY=

# Ad blocking. Pi-hole 6+: an app password from Settings, Web interface / API
# (blank when the web interface has no password). AdGuard Home: your sign-in.
PIHOLE_URL=http://192.168.1.10:8053
PIHOLE_PASSWORD=
ADGUARD_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Uptime Kuma: a status page's monitors. No key; the slug is the end of
# the page's address (/status/home is home).
UPTIME_KUMA_URL=http://192.168.1.10:3001
UPTIME_KUMA_SLUG=home

# ---- TrueNAS ----------------------------------------------------------------

# A key for a user whose only role is Read-Only Administrator. wss:// only:
# TrueNAS revokes a key sent over plain ws://.
TRUENAS_URL=wss://192.168.1.10/api/current
TRUENAS_API_KEY=
# 1 if your TrueNAS has a real certificate (it ships a self-signed one)
TRUENAS_VERIFY_TLS=0

# ---- Unraid -------------------------------------------------------------------

# Settings, Management Access, API Keys: a key with read access.
UNRAID_URL=http://192.168.1.10
UNRAID_KEY=

# ---- Synology DSM -------------------------------------------------------------

# An account in the administrators group, without two-factor sign-in.
SYNOLOGY_URL=https://192.168.1.20:5001
SYNOLOGY_USERNAME=patchboard
SYNOLOGY_PASSWORD=
# 1 if DSM has a real certificate (it ships a self-signed one)
SYNOLOGY_VERIFY_TLS=0

# ---- QNAP QTS ------------------------------------------------------------------

# A user without two-step verification.
QNAP_URL=https://192.168.1.30
QNAP_USERNAME=patchboard
QNAP_PASSWORD=
# 1 if QTS has a real certificate (it ships a self-signed one)
QNAP_VERIFY_TLS=0

# ---- Portainer ----------------------------------------------------------------

# Your account, Access tokens, Add access token.
PORTAINER_URL=https://192.168.1.10:9443
PORTAINER_KEY=

# ---- Netdata, Prometheus -------------------------------------------------------

# Their firing alerts join Needs attention.
NETDATA_URL=http://192.168.1.10:19999
PROMETHEUS_URL=http://192.168.1.10:9090
# Only if a proxy in front of Prometheus asks for a bearer token
PROMETHEUS_TOKEN=

# ---- UniFi, Tailscale ----------------------------------------------------------

# UniFi OS console, Network 9.0+: Control Plane, Integrations, Create API Key.
UNIFI_URL=https://192.168.1.1
UNIFI_KEY=
# 1 if the console has a real certificate (it ships a self-signed one)
UNIFI_VERIFY_TLS=0
# Tailscale admin console: Settings, Keys, Generate access token.
TAILSCALE_KEY=
# Leave empty for the token's own tailnet
TAILSCALE_TAILNET=

# ---- More apps ------------------------------------------------------------------

# Lidarr, Readarr, Prowlarr: Settings, General, API Key.
LIDARR_URL=http://192.168.1.10:8686
LIDARR_KEY=
READARR_URL=http://192.168.1.10:8787
READARR_KEY=
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_KEY=
# Bazarr: Settings, General, Security, API Key.
BAZARR_URL=http://192.168.1.10:6767
BAZARR_KEY=
# Audiobookshelf: an admin's API token. Navidrome: a user (admin sees everyone).
AUDIOBOOKSHELF_URL=http://192.168.1.10:13378
AUDIOBOOKSHELF_TOKEN=
NAVIDROME_URL=http://192.168.1.10:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Gitea or Forgejo: Settings, Applications, a token reading notifications and repos.
GITEA_URL=http://192.168.1.10:3000
GITEA_TOKEN=
# Calendars: iCal addresses, comma-separated. They work like passwords.
CALENDAR_URLS=
# Books: Hardcover (Settings, Hardcover API) or a public Goodreads user ID.
HARDCOVER_TOKEN=
GOODREADS_USER=
# Paperless-ngx: your profile, API Auth Token.
PAPERLESS_URL=http://192.168.1.10:8000
PAPERLESS_TOKEN=
# Nextcloud: an admin's app password (Security, Devices & sessions).
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=admin
NEXTCLOUD_PASSWORD=

# ---- NUT (UPS) ----------------------------------------------------------------

# The NUT server your UPS reports to, port 3493 unless you add one.
NUT_HOST=192.168.1.10

# ---- Glances -----------------------------------------------------------------

# One machine or several, comma-separated. Glances in web server mode (-w).
GLANCES_URL=http://192.168.1.10:61208

# ---- Scrutiny ---------------------------------------------------------------

# Scrutiny's web address. No key: keep it on a private address.
SCRUTINY_URL=http://192.168.1.10:8080

# ---- Proxmox VE -------------------------------------------------------------

# An API token with the PVEAuditor role (Datacenter, Permissions, API Tokens).
# Add PVEVMUser to start, shut down and reboot guests from the widget.
PROXMOX_URL=https://192.168.1.20:8006
PROXMOX_TOKEN_ID=patchboard@pve!dash
PROXMOX_SECRET=
# 1 if Proxmox has a real certificate (it ships a self-signed one)
PROXMOX_VERIFY_TLS=0

# Home Assistant: a long-lived access token from your profile, Security.
HA_URL=http://192.168.1.10:8123
HA_TOKEN=

# Tessie, for a Tesla. TESSIE_VIN only if the account has more than one car.
TESSIE_TOKEN=
TESSIE_VIN=

# Wake-on-LAN: Name=MAC pairs. Needs host networking (examples/wake-on-lan).
WOL_DEVICES=
WOL_BROADCAST=255.255.255.255
