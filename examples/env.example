# Optional. Everything here can be set in Settings instead.
# To keep config in a file: copy this to .env, keep the lines you set, and add
# `env_file: .env` to the service. A value here overrides Settings.

# Server
TZ=America/New_York
# Any long random string. Encrypts the keys saved in Settings.
PATCHBOARD_SECRET_KEY=
# Other names you open Patchboard by, comma-separated
ALLOWED_HOSTS=
DEMO=0

# Sign-in and safety
# none, password, forward or oidc
AUTH=none
TRUSTED_USER_HEADER=Remote-User
PATCHBOARD_PASSWORD=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ALLOWED=
OIDC_NAME=
HOOK_TOKEN=
READ_ONLY=0
DOCKER_SOCKET=/var/run/docker.sock
# tcp://socket-proxy:2375 to go through a socket proxy
DOCKER_HOST=

# Alerts
# Your own domains, comma-separated
CHECK_DOMAINS=
POOL_WARN_PCT=85
POOL_CRIT_PCT=95
DISK_WARN_C=50
DISK_CRIT_C=58
UPCOMING_DAYS=14

# Folders
POOL_PATH=
DOCS_PATH=
LOGS_PATH=
COMPOSE_ROOT=

