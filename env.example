# Patchboard configuration. Copy this file to .env next to docker-compose.yml
# and fill in what you use. Never commit the copy. Every integration is
# optional and turns on only when all of its variables are set.
# docs/CONFIGURATION.md explains each variable.

# ---- Basics -----------------------------------------------------------------

# Address to publish on. Patchboard has no login: bind it to a private
# address (a Tailscale IP, a LAN IP behind your firewall, or 127.0.0.1 behind
# a reverse proxy), never to a public one.
BIND_ADDRESS=127.0.0.1
TZ=America/New_York

# 1 runs on invented data with no network access (for trying it out).
DEMO=0

# ---- Checks and thresholds --------------------------------------------------

# Every service link on a private or tailnet address is requested once a
# minute. Add your own domains to check those links too, e.g. example.com.
CHECK_DOMAINS=
POOL_WARN_PCT=85
DISK_WARN_C=50
UPCOMING_DAYS=14

# ---- Weather (Open-Meteo, no key) -------------------------------------------

WEATHER_LAT=
WEATHER_LON=
WEATHER_LABEL=

# ---- Logs -------------------------------------------------------------------

# Optional link out to Dozzle for heavier log work.
DOZZLE_URL=

# ---- Media ------------------------------------------------------------------

SONARR_URL=http://192.168.1.10:8989
SONARR_KEY=

RADARR_URL=http://192.168.1.10:7878
RADARR_KEY=

TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_KEY=

QBIT_URL=http://192.168.1.10:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# Trakt: create an app at trakt.tv/oauth/applications with redirect URI
# http://localhost (the sign-in uses a code, not the redirect), then connect
# from Patchboard > Settings. TRAKT_ACCESS_TOKEN is an alternative to the secret.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_ACCESS_TOKEN=

# ---- Reading and mail -------------------------------------------------------

MINIFLUX_URL=http://192.168.1.10:8084
# Miniflux > Settings > API Keys
MINIFLUX_TOKEN=

# Fastmail > Settings > Privacy & Security > API tokens, read-only Email scope.
FASTMAIL_TOKEN=
FASTMAIL_WEB_URL=https://app.fastmail.com/mail/Inbox/

# ---- Home -------------------------------------------------------------------

FRIGATE_URL=http://192.168.1.10:5000

# ---- TrueNAS ----------------------------------------------------------------

# Pool health and capacity, scrubs, disks, alerts, cloud sync. Patchboard
# only queries. Use a key for a user whose only privilege is Read-Only
# Administrator. Must be wss://: TrueNAS revokes a key sent over plain ws://.
TRUENAS_URL=wss://192.168.1.10/api/current
TRUENAS_API_KEY=
# TrueNAS ships a self-signed certificate. Set to 1 if yours is real.
TRUENAS_VERIFY_TLS=0
