# Patchboard configuration template. Copy to .env and fill it in; never
# commit .env. Every integration is optional and turns on only when all of
# its variables are set.

TAILSCALE_IP=192.168.1.10
TZ=America/Chicago

# Set to 1 to run on invented data with no network access (portfolio demo).
DEMO=0

# Service checks: every service link on a private or tailnet address is
# requested once a minute to confirm the app answers. Add domains here to
# check those links too (they go out and back through your tunnel).
CHECK_DOMAINS=

# Alert when the pool is at least this full, or a disk at least this hot.
POOL_WARN_PCT=85
DISK_WARN_C=50
UPCOMING_DAYS=14

# Weather (Open-Meteo, no key). Two decimals is plenty.
WEATHER_LAT=33.17
WEATHER_LON=-97.17
WEATHER_LABEL=Riverside

# Links out to Dozzle for heavier log work.
DOZZLE_URL=http://192.168.1.10:9999

SONARR_URL=http://192.168.1.10:30113
SONARR_KEY=

RADARR_URL=http://192.168.1.10:30025
RADARR_KEY=

TAUTULLI_URL=http://192.168.1.10:30047
TAUTULLI_KEY=

QBIT_URL=http://192.168.1.10:8085
QBIT_USERNAME=
QBIT_PASSWORD=

MINIFLUX_URL=http://192.168.1.10:8084
# Miniflux > Settings > API Keys
MINIFLUX_TOKEN=

# Fastmail > Settings > Privacy & Security > API tokens. Read-only Email scope.
FASTMAIL_TOKEN=
# Where mail links open. Your Homepage bookmark URL works here.
FASTMAIL_WEB_URL=https://app.fastmail.com/mail/Inbox/

# Trakt: create an app at trakt.tv/oauth/applications (redirect URI
# http://localhost; the sign-in uses a code, not the redirect), then connect
# from Patchboard > Settings. TRAKT_ACCESS_TOKEN is an alternative to the secret.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_ACCESS_TOKEN=

FRIGATE_URL=http://192.168.1.10:5000

# TrueNAS: pool health and capacity, scrubs, disks, alerts, cloud sync.
# Patchboard only ever queries. Safest is a key for a user whose only
# privilege is Read-Only Administrator (Credentials > Groups > Privileges),
# created under Credentials > API Keys.
# Must be wss://. TrueNAS revokes any key that is ever sent over plain ws://.
TRUENAS_URL=wss://192.168.1.10/api/current
TRUENAS_API_KEY=
# The TrueNAS certificate is self-signed by default. Set to 1 if yours is real.
TRUENAS_VERIFY_TLS=0
